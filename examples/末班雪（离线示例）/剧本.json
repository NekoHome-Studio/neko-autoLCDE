        {
          "kind": "say",
          "who": "老周",
          "text": "每年的今日都有人来。你们记性真好。"
        },
        {
          "kind": "say",
          "who": "苏晚",
          "text": "我不是记性好。我在等人。",
          "face": "低头"
        },
