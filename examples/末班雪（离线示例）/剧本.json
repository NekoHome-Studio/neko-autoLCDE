          "kind": "enter",
          "who": "老周",
          "face": "常态",
          "slot": "center",
          "time": 0.45
        },
        {
          "kind": "sfx",
          "cue": "wind"
        },
        {
          "kind": "narr",
          "text": "风把门顶开一条缝。一个女人带着一身雪进来。"
