          "const": "lcde"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "kind": {
          "const": "story"
        },
        "generator": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/:*?\"<>|]+$",
          "description": "剧本文件名（无扩展名），不能含路径分隔符或 Windows 非法字符"
        },
        "backgrounds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "相对 BG\\ 的图片路径，含扩展名（.png .jpg .jpeg .bmp .tiff .webp）"
        },
        "characters": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "相对 Character\\ 的 .ch 路径"
                  },
                  "alias": {
                    "type": "string",
                    "description": "供命令里用别名引用"
                  }
                }
              }
            ]
          },
          "description": "字符串简写或 {path, alias} 对象"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "project": {
      "title": "工程",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "kind"
      ],
      "properties": {
        "format": {
          "const": "lcde"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "kind": {
          "const": "project"
        },
        "generator": {
          "type": "string"
        },
        "saveDir": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/character"
          }
        },
        "stories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/story"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/character"
    },
    {
      "$ref": "#/$defs/story"
    },
    {
      "$ref": "#/$defs/project"
    }
  ]
}
